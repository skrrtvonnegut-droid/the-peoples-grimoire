{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:peoples-grimoire:schema:bootstrap-profile:0.1.0",
  "title": "Grimoire Bootstrap Profile",
  "description": "An operator-approved, provider-neutral topology derived from bounded discovery. Raw history and credentials are out of scope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instance", "carriers", "discovery", "domains", "preferences"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "deployment_context", "operator_label", "classification_boundary"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "deployment_context": {"enum": ["personal", "employer_approved", "community"]},
        "operator_label": {"type": "string", "minLength": 1, "maxLength": 120},
        "classification_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "excluded"],
          "properties": {
            "allowed": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["public", "personal_private", "professional_portfolio", "employer_confidential"]}
            },
            "excluded": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "contains": {"const": "secrets"},
              "items": {"enum": ["public", "personal_private", "professional_portfolio", "employer_confidential", "secrets"]}
            }
          }
        }
      }
    },
    "carriers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cognition", "semantic_memory", "versioned_artifacts", "secret_store"],
      "properties": {
        "cognition": {"$ref": "#/$defs/carrier", "properties": {"role": {"const": "cognition"}}},
        "semantic_memory": {"$ref": "#/$defs/carrier", "properties": {"role": {"const": "semantic_memory"}}},
        "versioned_artifacts": {"$ref": "#/$defs/carrier", "properties": {"role": {"const": "versioned_artifacts"}}},
        "secret_store": {"$ref": "#/$defs/carrier", "properties": {"role": {"const": "secret_store"}}}
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_at", "sources", "raw_inventory_retention", "excluded_subjects"],
      "properties": {
        "approved_at": {"type": "string", "format": "date-time"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "raw_inventory_retention": {"const": "ephemeral"},
        "excluded_subjects": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/domain"}
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_core_repository", "control_plane_title", "preserve_existing_structure"],
      "properties": {
        "private_core_repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "control_plane_title": {"type": "string", "minLength": 1, "maxLength": 160},
        "preserve_existing_structure": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"instance": {"properties": {"deployment_context": {"const": "personal"}}}}},
      "then": {
        "properties": {
          "instance": {
            "properties": {
              "classification_boundary": {
                "properties": {
                  "allowed": {"not": {"contains": {"const": "employer_confidential"}}},
                  "excluded": {"contains": {"const": "employer_confidential"}}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "carrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "provider", "interface", "connection_state", "capabilities", "scope_summary"],
      "properties": {
        "role": {"enum": ["cognition", "semantic_memory", "versioned_artifacts", "secret_store"]},
        "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "interface": {"enum": ["host_native", "chatbot_ui", "local_cli", "api", "manual", "outside_chat"]},
        "connection_state": {"enum": ["available", "manual", "unavailable", "planned"]},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "scope_summary": {"type": "string", "minLength": 1, "maxLength": 320}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "provider", "scope_summary", "content_policy", "approved"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "kind": {"enum": ["chat_history", "notebook", "file_library", "knowledge_base", "version_control", "other"]},
        "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "scope_summary": {"type": "string", "minLength": 1, "maxLength": 320},
        "content_policy": {"enum": ["metadata_only", "summaries_only", "selected_content"]},
        "approved": {"const": true}
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_id", "name", "slug", "purpose", "classification", "confidence", "evidence", "artifact_routes", "review_cadence", "related_domains"],
      "properties": {
        "stable_id": {"type": "string", "pattern": "^domain\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 600},
        "classification": {"enum": ["public", "personal_private", "professional_portfolio", "employer_confidential"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_count", "signal_labels", "summary"],
          "properties": {
            "source_count": {"type": "integer", "minimum": 1},
            "signal_labels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "summary": {"type": "string", "minLength": 1, "maxLength": 500}
          }
        },
        "artifact_routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/route"}},
        "review_cadence": {"type": "string", "minLength": 1, "maxLength": 80},
        "related_domains": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^domain\\."}}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "lifecycle", "canonical_role", "reference_roles", "reason"],
      "properties": {
        "artifact_type": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "lifecycle": {"enum": ["ephemeral", "distill", "version", "both", "archive"]},
        "canonical_role": {"enum": ["none", "semantic_memory", "versioned_artifacts"]},
        "reference_roles": {"type": "array", "uniqueItems": true, "items": {"enum": ["cognition", "semantic_memory", "versioned_artifacts"]}},
        "reason": {"type": "string", "minLength": 1, "maxLength": 320}
      },
      "allOf": [
        {"if": {"properties": {"lifecycle": {"const": "ephemeral"}}}, "then": {"properties": {"canonical_role": {"const": "none"}}}},
        {"if": {"properties": {"lifecycle": {"const": "distill"}}}, "then": {"properties": {"canonical_role": {"const": "semantic_memory"}}}},
        {"if": {"properties": {"lifecycle": {"const": "version"}}}, "then": {"properties": {"canonical_role": {"const": "versioned_artifacts"}}}}
      ]
    }
  }
}
